# Copy to server/.env on the server. The CLI loads it; existing env vars win.
# Never copy these values to client/ or send credentials in chat.
ZDOG_AUTH_ISSUER=https://auth.942295.xyz
ZDOG_AUTH_CLIENT_ID=
ZDOG_AUTH_CLIENT_SECRET=

# Optional: add explicit local dev origins here when wiring H5 authentication.
# CORS_ORIGINS=https://yizhuh5-h.942295.xyz,https://yizhuh5.942295.xyz,http://127.0.0.1:10086

# Optional local static preview only; public H5 is served directly by Nginx.
# YIZHU_H5_DIST=/srv/yizhu/client/dist/h5

# Optional private SQLite/photo storage. Must stay outside the public H5 root.
# YIZHU_DATA_DIR=/srv/yizhu/private-data

# Recognition selection is server-only; change and restart to switch.
# Choices: bioclip-v1 (default), bioclip-v2-rerank, bioclip-v2-whole,
#          bioclip-multiview-plantclef (experimental local cascade).
# The v2 solutions are experimental and require local verified v2 weights.
# The cascade also requires prepared PlantCLEF assets; see docs/recognition-cascade.md.
YIZHU_RECOGNITION_SOLUTION=bioclip-v1
