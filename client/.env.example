# Copy to .env.local; no credentials are needed for normal builds.
TARO_APP_ID=touristappid

# Only needed for the explicit preview:weapp / upload:weapp commands.
# Use a real AppID above. Key paths may be absolute or relative to client/.
# For example: .secrets/private.key (.secrets/, *.key and *.pem are Git-ignored).
# Do not put keys in src/ or dist/. chmod 600 the key. No AppSecret needed.
MINIPROGRAM_PRIVATE_KEY_PATH=
MINIPROGRAM_VERSION=0.1.0
MINIPROGRAM_DESCRIPTION=Personal mock sample
